# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# "True" for local development, "False" in production
DJANGO_DEBUG=True

# Comma separated. In production, set this to your real domain(s), e.g.:
# DJANGO_ALLOWED_HOSTS=companytwin.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated, required in production for CSRF to accept form posts, e.g.:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://companytwin.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Only needed if your platform is behind a proxy that already terminates
# HTTPS but you still want Django to force-redirect (usually True in prod)
DJANGO_SECURE_SSL_REDIRECT=True

# Optional — leave unset to use the built-in offline question bank.
# When set, the AI engine automatically switches to live GPT-generated questions.
OPENAI_API_KEY=

# Optional — only used if you deploy with a managed Postgres database.
# Leave unset to keep using local SQLite.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
